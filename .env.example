# ---------------------------------------------------------------------------
# U Design website — environment variables
# Copy to .env.local for local development. Never commit real values.
# Secrets must NEVER use the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# Canonical origin (no trailing slash). Replace with the production domain (Q-9).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (lead management dashboard at /admin). Project Settings > API.
# NEXT_PUBLIC_* values are safe to expose; the service role key is NOT — it
# bypasses Row Level Security and must only ever be read on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lead delivery: console | email | webhook | email+webhook
# "console" is for local development only and is rejected in production.
LEAD_DELIVERY_PROVIDER=console

# Email adapter (Resend-compatible HTTP API)
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
RESEND_API_KEY=

# Webhook adapter (CRM, Google Sheets via Apps Script, Zapier, Make, ...)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Signs the consultation form render timestamp (any long random string)
FORM_SIGNING_SECRET=

# Optional: Cloudflare Turnstile (only if spam gets through other layers)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics (off unless set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# "required" delays analytics scripts until consent is granted (Q-5)
NEXT_PUBLIC_ANALYTICS_CONSENT=

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=

# Preview/test only: render draft content. Never set in Production.
CONTENT_INCLUDE_DRAFTS=false

# Test/dev overrides
FORM_MIN_FILL_MS=3000
FORM_RATE_LIMIT_MAX=5
