{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/solutions/erp",
        "http://localhost:3100/industries/manufacturing",
        "http://localhost:3100/portfolio/manufacturing-erp",
        "http://localhost:3100/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 30720
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https?://[^/]+/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "comment": "Home carries GSAP + ScrollTrigger for the hero entrance and Services/Industries scroll reveals (~45KB gzip); 245760 = 240KB.",
                "maxNumericValue": 245760
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/contact$)(?!^https?://[^/]+/$).*",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "comment": "Raised from 163840 (160KB): measured ~183KB gzip site-wide as of the 2026-09 redesign, unrelated to GSAP (those pages don't load it). 204800 = 200KB.",
                "maxNumericValue": 204800
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/contact$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "comment": "Raised from 174080 (170KB) for the same reason as the general rule, plus the consultation form's client JS. 215040 = 210KB.",
                "maxNumericValue": 215040
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
